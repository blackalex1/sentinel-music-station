# Dockerfile для сборки бинарника Sentinel Station под 32-bit ARM (Яндекс.Станция)
FROM rust:1.80-bullseye AS builder

RUN dpkg --add-architecture armhf && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        gcc-arm-linux-gnueabihf \
        libc6-dev-armhf-cross \
        libasound2-dev:armhf \
        pkg-config && \
    rm -rf /var/lib/apt/lists/*

RUN rustup target add armv7-unknown-linux-gnueabihf

ENV CARGO_TARGET_ARMV7_UNKNOWN_LINUX_GNUEABIHF_LINKER=arm-linux-gnueabihf-gcc \
    PKG_CONFIG_ALLOW_CROSS=1 \
    PKG_CONFIG_PATH=/usr/lib/arm-linux-gnueabihf/pkgconfig

WORKDIR /build
COPY Cargo.toml ./
# Кэширование зависимостей
RUN mkdir src && echo "fn main() {}" > src/main.rs && \
    cargo build --target armv7-unknown-linux-gnueabihf --release || true && \
    rm -rf src

COPY src ./src
RUN cargo build --target armv7-unknown-linux-gnueabihf --release

FROM scratch AS export
COPY --from=builder /build/target/armv7-unknown-linux-gnueabihf/release/sentinel-station /sentinel-station
