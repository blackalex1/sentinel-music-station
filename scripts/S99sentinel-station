#!/bin/sh
DIR=/data/opt/sentinel-station
BIN=$DIR/bin/sentinel-station
CONF=$DIR/config.toml
LOG=$DIR/logs/station.log

start() {
  [ -x "$BIN" ] || return 1
  pidof sentinel-station >/dev/null 2>&1 && return 0
  "$BIN" --config "$CONF" start </dev/null >>"$LOG" 2>&1 &
}

case "$1" in
  start)
    start
    ;;
  stop)
    killall sentinel-station 2>/dev/null
    ;;
  restart)
    killall sentinel-station 2>/dev/null
    sleep 1
    start
    ;;
  status)
    if pidof sentinel-station >/dev/null 2>&1; then
      echo "running (PID: $(pidof sentinel-station))"
    else
      echo "stopped"
    fi
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
exit 0
