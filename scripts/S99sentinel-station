#!/bin/sh
# ==============================================================================
# Sentinel Station Init & Supervisor Script with Circuit Breaker (Fail-Safe)
# and Active Network Self-Healing Multi-Tier Watchdog
# ==============================================================================
DIR=/data/opt/sentinel-station
BIN=$DIR/bin/sentinel-station
CONF=$DIR/config.toml
LOG=$DIR/logs/station.log
DISABLED=$DIR/disabled
CRASH_LOG=/tmp/sentinel-station.crashes
SUPERVISOR_PIDFILE=/var/run/sentinel-supervisor.pid
WATCHDOG_PIDFILE=/var/run/sentinel-watchdog.pid

cleanup_ipc() {
  # Очистка устаревших System V IPC семафоров и сегментов памяти ALSA dmix (ipc_key 1024)
  for s in $(ipcs -s 2>/dev/null | awk '$1=="0x00000400"{print $2}'); do ipcrm -s "$s" 2>/dev/null; done
  for m in $(ipcs -m 2>/dev/null | awk '$1=="0x00000400"||$1=="0x00000401"{print $2}'); do ipcrm -m "$m" 2>/dev/null; done
}

network_watchdog() {
  # Безопасный сторож Wi-Fi сети (Zero Hardcode, без убийства системных демонов и без reboot)
  FAIL_COUNT=0

  while true; do
    sleep 30

    # 1. Извлекаем хост сервера из конфигурации (если указан)
    SERVER_HOST=$(sed -n 's/^[[:space:]]*server_url[[:space:]]*=[[:space:]]*"[^:]*:\/\/\([^:/]*\).*/\1/p' "$CONF" 2>/dev/null)

    # 2. Проверяем состояние Wi-Fi ассоциации (wpa_supplicant)
    WPA_STATE=$(wpa_cli status 2>/dev/null | sed -n 's/^wpa_state=//p')

    # 3. Динамически определяем шлюз по умолчанию из текущей таблицы маршрутизации ядра
    GATEWAY=$(ip route 2>/dev/null | awk '/default/ {print $3}' | head -n 1)

    IS_NET_OK=1

    if [ -n "$WPA_STATE" ] && [ "$WPA_STATE" != "COMPLETED" ]; then
      IS_NET_OK=0
    elif [ -n "$GATEWAY" ] && ! ping -c 1 -w 2 "$GATEWAY" >/dev/null 2>&1; then
      # Если шлюз временно не ответил, проверяем сервер Sentinel (если хост задан)
      if [ -n "$SERVER_HOST" ]; then
        if ! ping -c 1 -w 2 "$SERVER_HOST" >/dev/null 2>&1; then
          IS_NET_OK=0
        fi
      else
        IS_NET_OK=0
      fi
    fi

    if [ "$IS_NET_OK" -eq 1 ]; then
      if [ "$FAIL_COUNT" -gt 0 ]; then
        echo "[network-watchdog] ✅ Связь с сетью стабильна (WPA: ${WPA_STATE:-N/A}, Шлюз: ${GATEWAY:-N/A})" >> "$LOG"
      fi
      FAIL_COUNT=0
      continue
    fi

    FAIL_COUNT=$((FAIL_COUNT + 1))
    echo "[network-watchdog] ⚠️ Задержка/потеря связи #$FAIL_COUNT (WPA: ${WPA_STATE:-N/A}, Шлюз: ${GATEWAY:-N/A})" >> "$LOG"

    # Мягкий запрос переподключения Wi-Fi только при длительном отсутствии связи (>3 минут)
    # НИКОГДА не убиваем wpa_supplicant (чтобы не сломать связь Квазара / Алисы),
    # НИКОГДА не перезапускаем dhcpcd (чтобы не удалить маршрут по умолчанию),
    # НИКОГДА не перезагружаем колонку (reboot).
    if [ "$FAIL_COUNT" -ge 6 ] && [ $((FAIL_COUNT % 4)) -eq 0 ]; then
      echo "[network-watchdog] 🔄 Мягкий запрос переподключения Wi-Fi через wpa_cli..." >> "$LOG"
      wpa_cli reconnect >/dev/null 2>&1 || wpa_cli reassociate >/dev/null 2>&1
    fi
  done
}

supervisor_loop() {
  mkdir -p "$DIR/logs"
  echo "[supervisor] Запуск защищенного супервайзера Sentinel Station (PID $$)" >> "$LOG"

  # Запуск сетевого сторожа
  network_watchdog </dev/null >/dev/null 2>&1 &
  NET_WATCHDOG_PID=$!
  echo "$NET_WATCHDOG_PID" > "$WATCHDOG_PIDFILE"

  while true; do
    # 1. Проверка защитного флага отключения (kill-switch)
    if [ -f "$DISABLED" ]; then
      echo "[supervisor] Обнаружен файл $DISABLED. Сервис деактивирован." >> "$LOG"
      if [ -f "$WATCHDOG_PIDFILE" ]; then
        kill -9 $(cat "$WATCHDOG_PIDFILE" 2>/dev/null) 2>/dev/null
        rm -f "$WATCHDOG_PIDFILE"
      fi
      rm -f "$SUPERVISOR_PIDFILE"
      exit 0
    fi

    cleanup_ipc

    START_TIME=$(date +%s)

    # 2. Запуск демона со стандартным приоритетом и флагом --quiet
    "$BIN" --config "$CONF" start --quiet >> "$LOG" 2>&1 &
    DAEMON_PID=$!

    # 3. Защита от OOM Killer: запретить ядру Linux убивать Sentinel при нехватке RAM
    if [ -d "/proc/$DAEMON_PID" ]; then
      echo -900 > "/proc/$DAEMON_PID/oom_score_adj" 2>/dev/null
    fi

    # Ожидание завершения работы демона
    wait "$DAEMON_PID"
    EXIT_CODE=$?
    END_TIME=$(date +%s)
    RUN_DURATION=$((END_TIME - START_TIME))

    # Если сервис остановлен штатно (код 0), очищаем историю аварий
    if [ "$EXIT_CODE" -eq 0 ]; then
      rm -f "$CRASH_LOG"
      sleep 2
      continue
    fi

    # Если процесс стабильно проработал дольше 60 секунд — сбрасываем старые счетчики аварий
    if [ "$RUN_DURATION" -gt 60 ]; then
      rm -f "$CRASH_LOG"
    fi

    # Фиксируем timestamp аварии
    NOW=$(date +%s)
    echo "$NOW" >> "$CRASH_LOG"

    # Предохранитель от частых падений (Circuit Breaker):
    # Не более 4 падений подряд за последние 60 секунд
    CUTOFF=$((NOW - 60))
    RECENT_CRASHES=0
    if [ -f "$CRASH_LOG" ]; then
      TMP_CRASHES="/tmp/crashes.$$"
      awk -v cutoff="$CUTOFF" '$1 > cutoff { print $1 }' "$CRASH_LOG" > "$TMP_CRASHES" 2>/dev/null
      mv -f "$TMP_CRASHES" "$CRASH_LOG"
      RECENT_CRASHES=$(wc -l < "$CRASH_LOG" 2>/dev/null || echo 0)
    fi

    if [ "$RECENT_CRASHES" -ge 4 ]; then
      echo "[CIRCUIT BREAKER] ⚠️ Зафиксировано $RECENT_CRASHES аварий подряд за 60 секунд!" >> "$LOG"
      echo "[CIRCUIT BREAKER] Переход в защитный режим ожидания на 15 минут для гарантированной стабильности Алисы." >> "$LOG"
      sleep 900
      rm -f "$CRASH_LOG"
      continue
    fi

    # Защитная пауза перед повторным запуском
    sleep 2
  done
}

start() {
  [ -x "$BIN" ] || { echo "Binary $BIN not found or not executable"; return 1; }
  
  if [ -f "$DISABLED" ]; then
    echo "Sentinel Station отключен флагом $DISABLED. Для включения удалите этот файл."
    return 0
  fi

  if pidof sentinel-station >/dev/null 2>&1; then
    echo "Sentinel Station уже запущен (PID: $(pidof sentinel-station))"
    return 0
  fi

  # Запуск супервайзера в фоновом режиме
  supervisor_loop </dev/null >/dev/null 2>&1 &
  echo $! > "$SUPERVISOR_PIDFILE"
  echo "Запущен защищенный супервайзер Sentinel Station"
}

stop() {
  # 1. Остановка сетевого сторожа
  if [ -f "$WATCHDOG_PIDFILE" ]; then
    WD_PID=$(cat "$WATCHDOG_PIDFILE" 2>/dev/null)
    [ -n "$WD_PID" ] && kill -9 "$WD_PID" 2>/dev/null
    rm -f "$WATCHDOG_PIDFILE"
  fi

  # 2. Остановка супервайзера
  if [ -f "$SUPERVISOR_PIDFILE" ]; then
    SUP_PID=$(cat "$SUPERVISOR_PIDFILE" 2>/dev/null)
    [ -n "$SUP_PID" ] && kill -9 "$SUP_PID" 2>/dev/null
    rm -f "$SUPERVISOR_PIDFILE"
  fi

  # 3. Мягкая остановка демона (SIGTERM)
  killall -15 sentinel-station 2>/dev/null
  sleep 1

  # Принудительное завершение только если процесс завис
  if pidof sentinel-station >/dev/null 2>&1; then
    killall -9 sentinel-station 2>/dev/null
  fi

  cleanup_ipc
  echo "Sentinel Station остановлен"
}

case "$1" in
  start)
    start
    ;;
  stop)
    stop
    ;;
  restart)
    stop
    sleep 1
    start
    ;;
  status)
    if pidof sentinel-station >/dev/null 2>&1; then
      echo "running (PID: $(pidof sentinel-station))"
    else
      if [ -f "$DISABLED" ]; then
        echo "stopped (disabled by kill-switch $DISABLED)"
      else
        echo "stopped"
      fi
    fi
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
exit 0
