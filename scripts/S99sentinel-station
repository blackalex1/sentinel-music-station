#!/bin/sh
# ==============================================================================
# Sentinel Station Init & Supervisor Script with Circuit Breaker (Fail-Safe)
# and Active Network Self-Healing Multi-Tier Watchdog
# ==============================================================================
DIR=/data/opt/sentinel-station
BIN=$DIR/bin/sentinel-station
CONF=$DIR/config.toml
LOG=$DIR/logs/station.log
DISABLED=$DIR/disabled
CRASH_LOG=/tmp/sentinel-station.crashes
SUPERVISOR_PIDFILE=/var/run/sentinel-supervisor.pid
WATCHDOG_PIDFILE=/var/run/sentinel-watchdog.pid

cleanup_ipc() {
  # Если аппаратный аудиовыход удерживается mediad на старте/перезапуске,
  # мягко сбрасываем mediad (quasar_launcher2 поднимет его чистым за 0.1с без захвата ALSA)
  if fuser /dev/snd/pcmC0D0p >/dev/null 2>&1; then
    for p in $(fuser /dev/snd/pcmC0D0p 2>/dev/null); do
      if [ -f "/proc/$p/cmdline" ] && grep -q -- "--mediad" "/proc/$p/cmdline" 2>/dev/null; then
        echo "[supervisor] Освобождение ALSA от зависшего mediad (PID $p)..." >> "$LOG"
        kill -9 "$p" 2>/dev/null
        sleep 1
      fi
    done
  fi

  for s in $(ipcs -s 2>/dev/null | awk '$1=="0x00000400"{print $2}'); do ipcrm -s "$s" 2>/dev/null; done
  for m in $(ipcs -m 2>/dev/null | awk '$1=="0x00000400"||$1=="0x00000401"{print $2}'); do ipcrm -m "$m" 2>/dev/null; done
}

network_watchdog() {
  # Интеллектуальный самовосстанавливающийся сторож Wi-Fi сети
  FAIL_COUNT=0

  # Извлекаем IP сервера из конфигурации
  SERVER_IP=$(sed -n 's/^[[:space:]]*server_url[[:space:]]*=[[:space:]]*"[^:]*:\/\/\([^:/]*\).*/\1/p' "$CONF" 2>/dev/null)
  [ -z "$SERVER_IP" ] && SERVER_IP="192.168.1.97"

  while true; do
    sleep 20

    # 1. Проверяем состояние Wi-Fi ассоциации (wpa_supplicant)
    WPA_STATE=$(wpa_cli status 2>/dev/null | sed -n 's/^wpa_state=//p')

    # 2. Проверяем шлюз по умолчанию
    GATEWAY=$(ip route 2>/dev/null | sed -n 's/.*default via \([0-9.]*\).*/\1/p' | head -n 1)
    [ -z "$GATEWAY" ] && GATEWAY="192.168.1.1"

    IS_NET_OK=1
    if [ "$WPA_STATE" != "COMPLETED" ]; then
      IS_NET_OK=0
    elif ! ping -c 2 -w 3 "$GATEWAY" >/dev/null 2>&1; then
      # Двойная проверка через сервер Sentinel Connect
      if ! ping -c 2 -w 3 "$SERVER_IP" >/dev/null 2>&1; then
        IS_NET_OK=0
      fi
    fi

    if [ "$IS_NET_OK" -eq 1 ]; then
      if [ "$FAIL_COUNT" -gt 0 ]; then
        echo "[network-watchdog] ✅ Связь с сетью успешно восстановлена (WPA: $WPA_STATE, Шлюз: $GATEWAY)" >> "$LOG"
      fi
      FAIL_COUNT=0
      continue
    fi

    FAIL_COUNT=$((FAIL_COUNT + 1))
    echo "[network-watchdog] ⚠️ Потеря связи с сетью #$FAIL_COUNT (WPA: $WPA_STATE, Шлюз: $GATEWAY)" >> "$LOG"

    # Не предпринимаем резких действий на кратковременные провалы (DFS / смену каналов роутером)
    # Ждем минимум 3 цикла (60 секунд стабильного отсутствия связи)
    if [ "$FAIL_COUNT" -lt 3 ]; then
      continue
    fi

    # Шаг 1 (~60 сек): Мягкая переассоциация с точкой доступа и обновление DHCP
    if [ "$FAIL_COUNT" -eq 3 ]; then
      echo "[network-watchdog] 🔄 Мягкая переассоциация Wi-Fi (wpa_cli reassociate)..." >> "$LOG"
      wpa_cli reassociate >/dev/null 2>&1
      dhcpcd -n wlan0 >/dev/null 2>&1
      sleep 10
    # Шаг 2 (~100-120 сек): Принудительный reconnect wpa_supplicant и мягкий рестарт DHCP
    elif [ "$FAIL_COUNT" -eq 5 ]; then
      echo "[network-watchdog] 🔄 Принудительный reconnect wpa_supplicant и рестарт DHCP..." >> "$LOG"
      wpa_cli disconnect >/dev/null 2>&1
      sleep 2
      wpa_cli reconnect >/dev/null 2>&1
      /etc/init.d/S41dhcpcd restart >/dev/null 2>&1
      sleep 15
    # Шаг 3 (~200 сек = ~3.5 мин): Перезапуск служб wpa_supplicant и dhcpcd (БЕЗ выгрузки драйверов ядра)
    elif [ "$FAIL_COUNT" -eq 9 ]; then
      echo "[network-watchdog] 🔄 Перезапуск служб wpa_supplicant и dhcpcd..." >> "$LOG"
      start-stop-daemon -K -x /usr/sbin/wpa_supplicant -p /var/run/wpa_supplicant.pid -o 2>/dev/null
      sleep 2
      /etc/init.d/S40wifi start >/dev/null 2>&1
      sleep 5
      /etc/init.d/S41dhcpcd restart >/dev/null 2>&1
      sleep 20
    # Шаг 4 (18 циклов = ~6 минут непрерывного полного блэкаута):
    # Если за 6 минут мягкие методы не помогли — произошел аппаратный сбой чипа/SDIO.
    # Чистая перезагрузка системы гарантированно восстановит Wi-Fi без зависаний ядра.
    elif [ "$FAIL_COUNT" -ge 18 ]; then
      echo "[network-watchdog] 🚨 Полный блэкаут сети (>6 минут). Аварийная перезагрузка колонки для сброса SDIO..." >> "$LOG"
      sync
      reboot -f
      exit 0
    fi
  done
}

supervisor_loop() {
  mkdir -p "$DIR/logs"
  echo "[supervisor] Запуск защищенного супервайзера Sentinel Station (PID $$)" >> "$LOG"

  # Запуск сетевого сторожа
  network_watchdog </dev/null >/dev/null 2>&1 &
  NET_WATCHDOG_PID=$!
  echo "$NET_WATCHDOG_PID" > "$WATCHDOG_PIDFILE"

  while true; do
    # 1. Проверка защитного флага отключения (kill-switch)
    if [ -f "$DISABLED" ]; then
      echo "[supervisor] Обнаружен файл $DISABLED. Сервис деактивирован." >> "$LOG"
      if [ -f "$WATCHDOG_PIDFILE" ]; then
        kill -9 $(cat "$WATCHDOG_PIDFILE" 2>/dev/null) 2>/dev/null
        rm -f "$WATCHDOG_PIDFILE"
      fi
      rm -f "$SUPERVISOR_PIDFILE"
      exit 0
    fi

    cleanup_ipc

    START_TIME=$(date +%s)

    # 2. Запуск демона с приоритетом nice -10 (защита звука ALSA от задержек CPU)
    # и флагом --quiet (тихий запуск без лишнего звукового приветствия посреди ночи)
    nice -n -10 "$BIN" --config "$CONF" start --quiet >> "$LOG" 2>&1 &
    DAEMON_PID=$!

    # 3. Защита от OOM Killer: запретить ядру Linux убивать Sentinel при нехватке RAM
    if [ -d "/proc/$DAEMON_PID" ]; then
      echo -900 > "/proc/$DAEMON_PID/oom_score_adj" 2>/dev/null
    fi

    # Ожидание завершения работы демона
    wait "$DAEMON_PID"
    EXIT_CODE=$?
    END_TIME=$(date +%s)
    RUN_DURATION=$((END_TIME - START_TIME))

    # Если сервис остановлен штатно (код 0), очищаем историю аварий
    if [ "$EXIT_CODE" -eq 0 ]; then
      rm -f "$CRASH_LOG"
      sleep 2
      continue
    fi

    # Если процесс стабильно проработал дольше 60 секунд — сбрасываем старые счетчики аварий
    if [ "$RUN_DURATION" -gt 60 ]; then
      rm -f "$CRASH_LOG"
    fi

    # Фиксируем timestamp аварии
    NOW=$(date +%s)
    echo "$NOW" >> "$CRASH_LOG"

    # Предохранитель от частых падений (Circuit Breaker):
    # Не более 4 падений подряд за последние 60 секунд
    CUTOFF=$((NOW - 60))
    RECENT_CRASHES=0
    if [ -f "$CRASH_LOG" ]; then
      TMP_CRASHES="/tmp/crashes.$$"
      awk -v cutoff="$CUTOFF" '$1 > cutoff { print $1 }' "$CRASH_LOG" > "$TMP_CRASHES" 2>/dev/null
      mv -f "$TMP_CRASHES" "$CRASH_LOG"
      RECENT_CRASHES=$(wc -l < "$CRASH_LOG" 2>/dev/null || echo 0)
    fi

    if [ "$RECENT_CRASHES" -ge 4 ]; then
      echo "[CIRCUIT BREAKER] ⚠️ Зафиксировано $RECENT_CRASHES аварий подряд за 60 секунд!" >> "$LOG"
      echo "[CIRCUIT BREAKER] Переход в защитный режим ожидания на 15 минут для гарантированной стабильности Алисы." >> "$LOG"
      sleep 900
      rm -f "$CRASH_LOG"
      continue
    fi

    # Защитная пауза перед повторным запуском
    sleep 2
  done
}

start() {
  [ -x "$BIN" ] || { echo "Binary $BIN not found or not executable"; return 1; }
  
  if [ -f "$DISABLED" ]; then
    echo "Sentinel Station отключен флагом $DISABLED. Для включения удалите этот файл."
    return 0
  fi

  if pidof sentinel-station >/dev/null 2>&1; then
    echo "Sentinel Station уже запущен (PID: $(pidof sentinel-station))"
    return 0
  fi

  # Запуск супервайзера в фоновом режиме
  supervisor_loop </dev/null >/dev/null 2>&1 &
  echo $! > "$SUPERVISOR_PIDFILE"
  echo "Запущен защищенный супервайзер Sentinel Station"
}

stop() {
  # 1. Остановка сетевого сторожа
  if [ -f "$WATCHDOG_PIDFILE" ]; then
    WD_PID=$(cat "$WATCHDOG_PIDFILE" 2>/dev/null)
    [ -n "$WD_PID" ] && kill -9 "$WD_PID" 2>/dev/null
    rm -f "$WATCHDOG_PIDFILE"
  fi

  # 2. Остановка супервайзера
  if [ -f "$SUPERVISOR_PIDFILE" ]; then
    SUP_PID=$(cat "$SUPERVISOR_PIDFILE" 2>/dev/null)
    [ -n "$SUP_PID" ] && kill -9 "$SUP_PID" 2>/dev/null
    rm -f "$SUPERVISOR_PIDFILE"
  fi

  # 3. Мягкая остановка демона (SIGTERM)
  killall -15 sentinel-station 2>/dev/null
  sleep 1

  # Принудительное завершение только если процесс завис
  if pidof sentinel-station >/dev/null 2>&1; then
    killall -9 sentinel-station 2>/dev/null
  fi

  cleanup_ipc
  echo "Sentinel Station остановлен"
}

case "$1" in
  start)
    start
    ;;
  stop)
    stop
    ;;
  restart)
    stop
    sleep 1
    start
    ;;
  status)
    if pidof sentinel-station >/dev/null 2>&1; then
      echo "running (PID: $(pidof sentinel-station))"
    else
      if [ -f "$DISABLED" ]; then
        echo "stopped (disabled by kill-switch $DISABLED)"
      else
        echo "stopped"
      fi
    fi
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
exit 0
